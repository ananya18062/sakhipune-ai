# .env.example — Template for local environment configuration
#
# HOW TO USE:
#   1. Copy this file:  copy .env.example .env
#   2. Fill in your real values in .env
#   3. Never commit .env to version control (it is in .gitignore)

# Application
APP_NAME=SakhiPune AI
DEBUG=True

# PostgreSQL — replace with your actual credentials
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://username:password@localhost:5432/sakhipune

# Frontend origin — where your HTML/JS frontend is served from
# Use http://localhost:5500 if you open it with VS Code Live Server
# Use http://127.0.0.1:5500 as an alternative
FRONTEND_URL=http://localhost:5500
FRONTEND_URL_ALT=http://127.0.0.1:5500

# External API transport
# How long (in seconds) to wait for an external data source before timing out
EXTERNAL_API_TIMEOUT_SECONDS=10.0

# ── External API keys ─────────────────────────────────────────────────────────
# Add keys here as new data-source integrations are introduced.
# Never put real keys in this file — it is committed to version control.
# Copy this file to .env and fill in real values there.

# Placeholder — replace with the correct variable name when a real
# data-source integration is added in a later task.
EXTERNAL_API_KEY=

# Education / Scholarship API — leave blank until a public endpoint is available
# When set, education_service.py attempts a live fetch before falling back to DB
EDUCATION_API_URL=

# Jobs / Employment API — leave blank until a public endpoint is available
# NCS and Mahaswayam require institutional login as of September 2026
# When set, jobs_service.py attempts a live fetch before falling back to DB
JOBS_API_URL=

# Internships API — leave blank until a public endpoint is available
# No public unauthenticated internship listings API exists for Pune/Maharashtra as of Sep 2026
# When set, internship_service.py attempts a live fetch before falling back to DB
INTERNSHIPS_API_URL=

# Healthcare API — leave blank until a public endpoint is available
# NHM, PMC and PMMVY portals are web-only without open JSON endpoints as of September 2026
# When set, healthcare_service.py attempts a live fetch before falling back to DB
HEALTHCARE_API_URL=

# Legal Support API — leave blank until a public endpoint is available
# DLSA and MSLSA portals are web-only without open JSON endpoints as of September 2026
# When set, legal_service.py attempts a live fetch before falling back to DB
LEGAL_API_URL=

# Financial Support API — leave blank until a public endpoint is available
# MAVIM, NULM and Jan Dhan portals are web-only without open JSON endpoints as of September 2026
# When set, financial_service.py attempts a live fetch before falling back to DB
FINANCIAL_API_URL=

# ── Deployment (Vercel) ───────────────────────────────────────────────────────
# Set DEBUG=False in production Vercel environment variables
# DEBUG=False

# ALLOWED_ORIGINS: comma-separated extra CORS origins for production.
# Set this in the Vercel dashboard after the first deployment to your domain.
# Example:  ALLOWED_ORIGINS=https://sakhipune-ai.vercel.app
# Leave empty during local development.
ALLOWED_ORIGINS=
